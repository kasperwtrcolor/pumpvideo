{
  "name": "pumpclip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "ingest": "tsx scripts/ingest.ts",
    "stonkfun": "tsx scripts/stonkfun.ts",
    "clips": "tsx scripts/gen-clips.ts",
    "sync": "tsx scripts/sync.ts",
    "verify-assets": "tsx scripts/verify-assets.ts",
    "diag": "tsx scripts/diag-sync.ts",
    "smoke": "tsx scripts/smoke.ts",
    "retention": "tsx scripts/retention.ts",
    "airdrop": "tsx scripts/snapshot-airdrop.ts",
    "scan-secrets": "tsx scripts/scan-secrets.ts",
    "seed": "tsx scripts/ingest.ts --top 40 --new 40 && tsx scripts/gen-clips.ts --limit 200 --concurrency 2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@pump-fun/pump-sdk": "^4.0.0",
    "@solana-program/memo": "^0.10.0",
    "@solana/kit": "^5.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-phantom": "^0.9.30",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/wallet-adapter-react-ui": "^0.9.40",
    "@solana/wallet-adapter-solflare": "^0.6.34",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "next": "16.3.6",
    "prisma": "^6.19.3",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
