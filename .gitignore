# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated media — committed on purpose: Vercel only deploys files that are in
# the repo, and ffmpeg cannot run in a serverless function. So clips are rendered
# locally and shipped as static assets.
# (public/clips and public/thumbs are tracked — do NOT ignore them)

# scratch dir used while rendering
/.clip-tmp
