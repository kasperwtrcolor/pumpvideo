// Postgres, not SQLite: Vercel's filesystem is read-only and ephemeral, so a
// file-backed DB cannot persist a single write. Locally we run Postgres too, so
// dev and prod share one storage engine and migrations are identical.
//
// `url` must be the POOLED connection (Vercel/Neon pgbouncer) so serverless
// invocations don't exhaust connections. `directUrl` is the unpooled one, used
// by migrations which cannot run through a transaction pooler.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A tradable coin. Mirrors the real pump.fun market record so we never invent prices.
model Coin {
  id          String  @id @default(cuid())
  mint        String  @unique // SPL mint address
  provider    String  @default("PUMPFUN")
  name        String
  symbol      String
  description String?
  imageUrl    String?

  // live market state (raw integer strings — bigint-safe)
  virtualSol   String @default("0") // lamports
  virtualToken String @default("0") // raw token units
  realSol      String @default("0")
  totalSupply  String @default("0")

  priceSol     Float @default(0) // SOL per whole token
  marketCapSol Float @default(0)
  change24hPct Float @default(0)
  /// Net price move over the trailing ~5 minutes, in percent. Sourced from
  /// Dexscreener's native `m5` for graduated coins, and from the delta between
  /// our own consecutive PricePoints for on-curve ones (the keeper samples every
  /// 5 minutes, so one sample back *is* the 5-minute mark).
  change5mPct  Float @default(0)
  /// Unsigned 5-minute volatility, used to rank the Hot feed. It is the sum of
  /// absolute step moves across the recent samples, not the size of the net
  /// move — so a coin that ran up *and* gave it back (a genuine reversal) scores
  /// higher than one that drifted the same distance in a straight line. That is
  /// what "gained and lost" means: both directions, both ranked.
  volatility5m Float @default(0)
  holders      Int   @default(0)
  volume24hSol Float @default(0)

  complete    Boolean @default(false) // bonding curve filled -> graduated to AMM
  isBanned    Boolean @default(false) // pump.fun moderation flag; hide from feed
  /// Retention state, set by the dead-token sweep (lib/retention.ts) when a coin
  /// has shown no trading volume for the grace period; cleared automatically the
  /// moment it trades again. Non-null means "hidden from every list and count".
  ///
  /// Deliberately NOT `isBanned`: that column mirrors pump.fun's own moderation
  /// flag and is rewritten on every ingest and keeper tick, so retention state
  /// stored there would be silently cleared by the next sync — a bug that would
  /// look like "hiding just doesn't work" rather than "something overwrote it".
  hiddenAt    DateTime?
  poolAddress String?
  creator     String?
  twitter     String?
  telegram    String?
  website     String?

  launchedAt   DateTime?
  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  clips     Clip[]
  positions Position[]
  prices    PricePoint[]
  followers TokenFollow[]

  @@index([marketCapSol])
  @@index([volatility5m])
  @@index([createdAt])
  /// Every visibility-filtered read touches this, and the retention sweep scans
  /// it to find what is currently hidden.
  @@index([hiddenAt])
}

/// Price history. Written by the market keeper on every sync; powers the
/// 24h change chip today and a sparkline/chart later.
model PricePoint {
  id           String   @id @default(cuid())
  coinId       String
  coin         Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)
  priceSol     Float
  marketCapSol Float
  at           DateTime @default(now())

  @@index([coinId, at])
}

/// A short vertical clip. One clip = one front door into a coin.
///
/// `source` distinguishes our seeded catalogue from clips a user uploaded and
/// bound to a token address. Uploaded clips carry `creatorWallet`, which is what
/// the 1% creator fee is paid to on every buy made through this clip.
model Clip {
  id       String @id @default(cuid())
  coinId   String
  coin     Coin   @relation(fields: [coinId], references: [id], onDelete: Cascade)

  source   String  @default("SEED") // SEED | UPLOAD | INGEST — INGEST = picked up by the keeper's new-token sweep
  /// Nullable on purpose. A clip whose video has not been rendered yet (a token
  /// that was just ingested, or a render still queued) has no file to point at,
  /// and the feed falls back to the coin's art. Making this required is what
  /// would force the ingester to write a URL for a file that does not exist.
  videoUrl String?
  thumbUrl String?
  /// Whether the feed may serve this clip at all. Set once the clip is fit to
  /// show — which for a video means the file exists, and for a freshly ingested
  /// token means its art is available (`videoUrl` is then null and the feed
  /// renders the art). The feed only serves ready clips, so a queued-but-
  /// unrendered clip never ships a broken <video>.
  ready    Boolean @default(false)
  caption  String?
  author   String? @default("unclaimed")

  /// Solana wallet paid the 1% creator fee. Null for seeded clips (fee then
  /// falls through to the treasury, so a buy is never silently free).
  creatorWallet String?
  /// Trader row that uploaded this clip (null for seeded clips).
  uploadedById  String?
  uploadedBy    Trader? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  /// Denormalised counters, kept in sync with the Clip* rows below. Denormalising
  /// is what lets the feed sort and render without an aggregate per item.
  likes    Int @default(0)
  shares   Int @default(0)
  comments Int @default(0)
  views    Int @default(0)
  rank     Float @default(0) // feed ordering score

  createdAt DateTime @default(now())

  likeRows    ClipLike[]
  commentRows ClipComment[]
  shareRows   ClipShare[]
  favoriteRows ClipFavorite[]
  notifications Notification[]

  @@index([coinId])
  @@index([rank])
  @@index([ready, rank])
  @@index([createdAt])
}

/// A viewer. Created anonymously on first request so a clip can be viewed with
/// no login at all; a Privy identity is bound on login.
///
/// Identity has two layers:
///   1. `handle` — an unguessable random string mirrored into an httpOnly cookie.
///      This is what makes an anonymous visit work with no login.
///   2. `privyDid` — set once the visitor logs in with Privy (email / Google / X).
///      The anonymous row is *adopted* at that moment, so anything they did while
///      anonymous (likes, comments, uploads) survives the upgrade.
model Trader {
  id            String  @id @default(cuid())
  handle        String  @unique // cookie/session identity, e.g. "anon-8f3a2c…"
  walletAddress String? @unique // the account's Solana wallet (embedded or linked)
  displayName   String?
  avatarUrl     String?

  /// Public handle. Optional on purpose: a viewer can watch, upload and even be
  /// followed by id without ever claiming one. What a username buys is a
  /// linkable, searchable, human-readable identity — so it is an upgrade, not a
  /// gate. Stored lowercase; uniqueness is case-insensitive as a result.
  username String? @unique
  bio      String?

  /// Denormalised social counts. The profile renders on every follow and the
  /// feed can badge a creator, so an aggregate per render would be wasteful —
  /// these are maintained by the follow/unfollow transaction that changes them.
  followerCount  Int @default(0)
  followingCount Int @default(0)

  // --- Privy identity. All null for a pure anonymous viewer. ---
  privyDid    String? @unique // "did:privy:…"
  email       String?
  loginMethod String? // EMAIL | GOOGLE | TWITTER
  walletId    String? // Privy wallet id backing `walletAddress`

  createdAt DateTime @default(now())

  positions Position[]
  trades    Trade[]
  clips     Clip[]
  likes     ClipLike[]
  comments  ClipComment[]
  shares    ClipShare[]
  favorites ClipFavorite[]

  /// People who follow this trader.
  followers Follow[] @relation("FollowTo")
  /// People this trader follows.
  following Follow[] @relation("FollowFrom")

  tokenFollows TokenFollow[]

  notifications     Notification[] @relation("NotifTo")
  notificationsSent Notification[] @relation("NotifFrom")

  @@index([privyDid])
  @@index([followerCount])
}

/// Current holding per coin, per trader — a mirror of what the wallet holds.
/// Live fills update this from the on-chain balance delta so the portfolio can
/// render without one RPC call per position.
model Position {
  id       String @id @default(cuid())
  traderId String
  trader   Trader @relation(fields: [traderId], references: [id], onDelete: Cascade)
  coinId   String
  coin     Coin   @relation(fields: [coinId], references: [id], onDelete: Cascade)

  tokenAmount String // raw token units held
  costSol     Float  @default(0) // total SOL spent (for PnL)
  realizedSol Float  @default(0)

  updatedAt DateTime @updatedAt

  @@unique([traderId, coinId])
}

/// Immutable trade log. Every row is a real on-chain fill; `txSig` is the
/// signature verified against the chain before the row was written.
model Trade {
  id       String @id @default(cuid())
  traderId String
  trader   Trader @relation(fields: [traderId], references: [id], onDelete: Cascade)

  coinMint String
  symbol   String
  side     String // BUY | SELL
  mode     String @default("LIVE")

  solAmount   Float
  tokenAmount String
  priceSol    Float
  /// total in-app fee charged in SOL (creator + treasury), for accounting
  feeSol      Float  @default(0)
  /// The 1% creator leg of `feeSol`, split out from the total, and the wallet it
  /// was paid to. Stored rather than derived because the creator is resolved from
  /// the *clip* the buyer came through — a join that is not available at read
  /// time, and a fact that stops being reconstructable the moment the clip is
  /// deleted. This is the ledger row behind "creator rewards earned".
  creatorFeeSol Float   @default(0)
  creatorWallet String?
  txSig       String? // the on-chain transaction signature

  createdAt DateTime @default(now())

  @@index([traderId, createdAt])
  @@index([coinMint, createdAt])
  /// Sums a creator's lifetime rewards (and the app-wide total paid) in one read.
  @@index([creatorWallet, createdAt])
}

/// One like per trader per clip. The unique key is what makes the toggle
/// idempotent — double taps can't inflate the count.
model ClipLike {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  traderId  String
  trader    Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clipId, traderId])
  @@index([clipId])
}

/// A comment. Login is required to write one, which is why `traderId` is not
/// optional — there is no "anonymous comment" row.
model ClipComment {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  traderId  String
  trader    Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([clipId, createdAt])
}

/// A share event. No unique key — sharing the same clip twice is legitimate and
/// counts twice, unlike a like.
model ClipShare {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  traderId  String?
  trader    Trader?  @relation(fields: [traderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([clipId])
}

/// A saved clip — "keep this one, I might buy it later".
///
/// Deliberately not a public counter. A like is a public signal and gets a
/// denormalised total on Clip; a favourite is a private bookmark, so there is
/// nothing to keep in sync and no reason for one trader to see another's list.
///
/// The unique key makes the toggle idempotent: saving twice cannot produce two
/// rows, so the saved list can never show the same coin twice.
model ClipFavorite {
  id        String   @id @default(cuid())
  clipId    String
  clip      Clip     @relation(fields: [clipId], references: [id], onDelete: Cascade)
  traderId  String
  trader    Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clipId, traderId])
  @@index([traderId, createdAt])
}

/// One trader following another.
///
/// The unique key makes the toggle idempotent — following twice cannot produce
/// two rows, so a follower count can never be inflated by a double tap. The
/// count on `Trader` is maintained alongside the row inside the same
/// transaction, which is what keeps the denormalised number honest.
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  follower    Trader   @relation("FollowFrom", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   Trader   @relation("FollowTo", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
  @@index([followerId, createdAt])
}

/// Following a *token* rather than a person.
///
/// A trader follows a coin because they want its market in front of them, and
/// every clip bound to that coin then shows up in their Following feed —
/// including clips uploaded by people they do not follow. That is the useful
/// half: a coin's clips come from many creators, and following the coin is how
/// you see all of them without following each one.
model TokenFollow {
  id        String   @id @default(cuid())
  traderId  String
  trader    Trader   @relation(fields: [traderId], references: [id], onDelete: Cascade)
  coinId    String
  coin      Coin     @relation(fields: [coinId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([traderId, coinId])
  @@index([coinId])
  @@index([traderId, createdAt])
}

/// An inbox row.
///
/// Three kinds, all of which the user asked to be told about:
///
///   FOLLOW     — someone started following you.
///   UPLOAD     — someone you follow posted a clip.
///   TOKEN_CLIP — a new clip landed on a coin you follow.
///
/// `actorId`/`clipId` are nullable and `onDelete: SetNull`/`Cascade` on purpose:
/// deleting an actor must not erase the fact that you were notified, only the
/// name attached to it. `coinMint` is stored as a plain string rather than a
/// relation so a token follow notification survives even if the coin is later
/// pruned from the catalogue.
model Notification {
  id       String  @id @default(cuid())
  traderId String
  trader   Trader  @relation("NotifTo", fields: [traderId], references: [id], onDelete: Cascade)

  /// FOLLOW | UPLOAD | TOKEN_CLIP
  type     String
  actorId  String?
  actor    Trader? @relation("NotifFrom", fields: [actorId], references: [id], onDelete: SetNull)

  clipId   String?
  clip     Clip?   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  coinMint String?

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([traderId, createdAt])
  @@index([traderId, read])
}
