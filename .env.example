# ── Local dev ────────────────────────────────────────────────────────────────
# Postgres locally, so dev and prod share one storage engine.
#   service postgresql start
#   su postgres -c "psql -c \"CREATE ROLE pumpclip LOGIN PASSWORD 'yourpw' CREATEDB;\""
#   su postgres -c "createdb -O pumpclip pumpclip"
#   npx prisma migrate dev
DATABASE_URL="postgresql://pumpclip:yourpw@localhost:5432/pumpclip?schema=public"
DIRECT_URL="postgresql://pumpclip:yourpw@localhost:5432/pumpclip?schema=public"

# ── Vercel (Project → Settings → Environment Variables) ──────────────────────
# Vercel Postgres is retired as a first-party product; Postgres now arrives via a
# Marketplace integration (Neon). Adding it injects DATABASE_URL (pooled,
# pgbouncer) and DATABASE_URL_UNPOOLED (direct) into the project.
#
# Serverless MUST use the pooled host, or concurrent invocations exhaust the
# connection limit. Migrations MUST use the direct host, because DDL cannot run
# through a transaction pooler. So map them across:
#   DATABASE_URL = <DATABASE_URL>            (the pooled one)
#   DIRECT_URL   = <DATABASE_URL_UNPOOLED>   (the direct one)
#
# Then apply migrations + seed in one step, from a machine with network access:
#   export PROD_DATABASE_URL='...' PROD_DIRECT_URL='...'
#   ./scripts/deploy-db.sh
#
# NOTE: Vercel Hobby cron jobs may only run ONCE PER DAY, which is far too stale
# for a price feed. The real market keeper runs from this VPS every 5 minutes —
# see scripts/sync-cron.sh.

# Read-only Solana RPC. The public endpoint rate-limits hard — use a private one
# (Helius / QuickNode / Triton) in prod.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Gates GET /api/sync. Vercel automatically sends `Authorization: Bearer $CRON_SECRET`
# on scheduled invocations when this env var exists.
# (Not needed for the 5-minute VPS keeper, which talks to Postgres directly.)
CRON_SECRET="generate-with-openssl-rand-hex-24"
