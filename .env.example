# ── Local dev ────────────────────────────────────────────────────────────────
# Postgres locally, so dev and prod share one storage engine.
#   service postgresql start
#   su postgres -c "psql -c \"CREATE ROLE pumpclip LOGIN PASSWORD 'yourpw' CREATEDB;\""
#   su postgres -c "createdb -O pumpclip pumpclip"
#   npx prisma migrate dev
DATABASE_URL="postgresql://pumpclip:yourpw@localhost:5432/pumpclip?schema=public"
DIRECT_URL="postgresql://pumpclip:yourpw@localhost:5432/pumpclip?schema=public"

# ── Vercel (Project → Settings → Environment Variables) ──────────────────────
# After attaching Vercel Postgres, Vercel injects POSTGRES_PRISMA_URL (pooled)
# and POSTGRES_URL_NON_POOLING (direct). Point ours at them — the pooled URL is
# mandatory on serverless, or you exhaust connections under concurrency:
#   DATABASE_URL = <POSTGRES_PRISMA_URL>
#   DIRECT_URL   = <POSTGRES_URL_NON_POOLING>
# Then run the migration once against the remote DB:  npm run db:migrate

# Read-only Solana RPC. The public endpoint rate-limits hard — use a private one
# (Helius / QuickNode / Triton) in prod.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Gates GET /api/sync, which Vercel Cron calls. Vercel automatically sends
# `Authorization: Bearer <CRON_SECRET>` when this env var exists.
CRON_SECRET="generate-with-openssl-rand-hex-24"
