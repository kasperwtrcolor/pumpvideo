# ── Local dev ────────────────────────────────────────────────────────────────
# Postgres locally, so dev and prod share one storage engine.
#   service postgresql start
#   su postgres -c "psql -c \"CREATE ROLE pumpclip LOGIN PASSWORD 'yourpw' CREATEDB;\""
#   su postgres -c "createdb -O pumpclip pumpclip"
#   npx prisma migrate dev
DATABASE_URL="postgresql://pumpclip:yourpw@localhost:5432/pumpclip?schema=public"
DIRECT_URL="postgresql://pumpclip:yourpw@localhost:5432/pumpclip?schema=public"

# ── Vercel (Project → Settings → Environment Variables) ──────────────────────
# Vercel Postgres is retired as a first-party product; Postgres now arrives via a
# Marketplace integration (Neon). Adding it injects DATABASE_URL (pooled,
# pgbouncer) and DATABASE_URL_UNPOOLED (direct) into the project.
#
# Serverless MUST use the pooled host, or concurrent invocations exhaust the
# connection limit. Migrations MUST use the direct host, because DDL cannot run
# through a transaction pooler. So map them across:
#   DATABASE_URL = <DATABASE_URL>            (the pooled one)
#   DIRECT_URL   = <DATABASE_URL_UNPOOLED>   (the direct one)
#
# Then apply migrations + seed in one step, from a machine with network access:
#   export PROD_DATABASE_URL='...' PROD_DIRECT_URL='...'
#   ./scripts/deploy-db.sh
#
# NOTE: Vercel Hobby cron jobs may only run ONCE PER DAY, which is far too stale
# for a price feed. The real market keeper runs from this VPS every 5 minutes —
# see scripts/sync-cron.sh.

# Read-only Solana RPC. The public endpoint rate-limits hard — use a private one
# (Helius / QuickNode / Triton) in prod.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Gates GET /api/sync. Vercel automatically sends an `Authorization: Bearer <CRON_SECRET>`
# header on scheduled invocations when this env var exists.
# (Not needed for the 5-minute VPS keeper, which talks to Postgres directly.)
CRON_SECRET="generate-with-openssl-rand-hex-24"

# ── Privy (login + embedded Solana wallets) ──────────────────────────────────
# Dashboard → App settings. The app id is public (it ships in the browser
# bundle); the secret is NOT — it must never be prefixed NEXT_PUBLIC_.
#
# In the Privy dashboard, also check:
#   • Login methods  → Email, Google, Twitter enabled
#   • Embedded wallets → Solana, "create on login"
#   • Allowed origins → must list every origin you serve from, including
#     http://localhost:3000 for local dev and your *.vercel.app domain.
#     Privy rejects an origin that isn't listed, and the error is opaque.
#   • Fiat on-ramp → must be enabled for "buy with card" top-ups; crypto
#     deposits (Receive) work without it.
NEXT_PUBLIC_PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET=<paste-app-secret-from-dashboard>

# Optional: browser-side Solana RPC used by the embedded wallet to submit
# transactions. Falls back to the public mainnet endpoint.
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# ── Live trading ─────────────────────────────────────────────────────────────
# Real on-chain buys/sells. The flow is:
#   1. browser → POST /api/trade/live/prepare  (server quotes Jupiter, returns an
#      UNSIGNED transaction — no key material ever reaches the server)
#   2. browser  signs it with the embedded Privy wallet
#   3. browser → POST /api/trade/live/confirm  (server re-reads the signature from
#      the chain, checks the signer, and records the real amounts)
#
# Jupiter's aggregator is used rather than the pump.fun program directly because
# one integration covers both the bonding curve ("Pump.fun") and the post-
# graduation AMM ("Pump.fun Amm"), whose account layouts differ.
#
# Set to "false" to pin the app to practice-only without touching any other code.
LIVE_TRADING_ENABLED="true"
